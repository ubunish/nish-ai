#!/usr/bin/env bash
# replay — score a question file against sessions that already happened.
#
# Builds a corpus from the Claude Code transcripts under ~/.claude/projects:
# each session contributes its first substantive prompt and the category the
# router actually dispatched to, taken from the first nish-ai category Skill
# call in that session. The question file is then run over every prompt and the
# answer compared with that label, so a threshold is chosen from numbers rather
# than guessed.
#
#   nish-ai-jev/replay --limit 100 ../nish-ai-prompt-recognition/jev/route.json
#
# Each sample runs from the directory the session ran in, so `jev` applies the
# origin allowlist per sample: a session from a repo that may not reach the API
# is skipped, never sent. That refusal is local and costs nothing, but it does
# count against --limit, which bounds sessions attempted rather than scored.
# Sessions are walked newest first, so a small limit reads recent behaviour.
#
# Prints accuracy and coverage per confidence threshold, plus p50 and p95
# latency. Tuning is a human decision; this only supplies the numbers.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
JEV="$SELF_DIR/jev"
PROJECTS="$HOME/.claude/projects"
ANSWER_ID="category"
TIMEOUT=5
LIMIT=0          # sessions to attempt, newest first; 0 = every session found
QUESTIONS=""

die() { printf 'replay: %s\n' "$1" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit)     LIMIT="${2:-0}"; shift 2 ;;
    --timeout)   TIMEOUT="${2:-5}"; shift 2 ;;
    --answer-id) ANSWER_ID="${2:-category}"; shift 2 ;;
    -*)          die "unknown flag: $1" ;;
    *)           QUESTIONS="$1"; shift ;;
  esac
done

[[ -n "$QUESTIONS" ]] || die "usage: replay [--limit N] [--timeout S] [--answer-id ID] QUESTION_FILE"
[[ -r "$QUESTIONS" ]] || die "question file not readable: $QUESTIONS"
[[ -d "$PROJECTS"  ]] || die "no transcripts at $PROJECTS"
command -v jq   >/dev/null || die "jq not found"
command -v perl >/dev/null || die "perl not found"

# The router's five categories, keyed by the skill each one dispatches to.
label_for_skill() { # $1 = skill name -> A..E
  case "$1" in
    nish-ai-project-planning)     echo A ;;
    nish-ai-user-question)        echo B ;;
    nish-ai-goal-oriented-coding) echo C ;;
    nish-ai-documentation)        echo D ;;
    nish-ai-quick-task)           echo E ;;
    *)                            echo "" ;;
  esac
}

# The first user turn that is a real prompt. A turn opening with "<" is harness
# scaffolding (command output, pasted content, a system reminder), not
# something the router ever had to categorize.
first_prompt() { # $1 = transcript -> JSON string, or nothing
  jq -c '
    select(.type == "user")
    | .message.content
    | (if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join("\n")) end)
    | select(type == "string" and length > 0 and (startswith("<") | not))
  ' "$1" 2>/dev/null | head -1
}

first_category_skill() { # $1 = transcript -> skill name, or nothing
  jq -r '
    select(.type == "assistant")
    | .message.content[]?
    | select(.type == "tool_use" and .name == "Skill")
    | .input.skill // empty
  ' "$1" 2>/dev/null \
    | grep -m1 -E '^nish-ai-(project-planning|user-question|goal-oriented-coding|documentation|quick-task)$'
}

session_cwd() { # $1 = transcript -> directory, or nothing
  jq -r 'select(.cwd != null) | .cwd' "$1" 2>/dev/null | head -1
}

now_ms() { perl -MTime::HiRes=time -e 'printf "%.0f", time * 1000'; }

TOTAL=0        # sessions that carried both a prompt and a label
SKIPPED=0      # samples jev refused or could not answer
RESULTS="$(mktemp)"   # one "<correct 0|1> <confidence>" line per answered sample
LATENCIES="$(mktemp)" # one millisecond figure per answered sample
trap 'rm -f "$RESULTS" "$LATENCIES"' EXIT

while IFS= read -r transcript; do
  [[ "$LIMIT" -gt 0 && "$TOTAL" -ge "$LIMIT" ]] && break

  skill="$(first_category_skill "$transcript")"
  [[ -n "$skill" ]] || continue
  label="$(label_for_skill "$skill")"
  [[ -n "$label" ]] || continue
  prompt="$(first_prompt "$transcript")"
  [[ -n "$prompt" ]] || continue
  dir="$(session_cwd "$transcript")"
  [[ -n "$dir" && -d "$dir" ]] || continue

  TOTAL=$((TOTAL + 1))
  started="$(now_ms)"
  answers="$(cd "$dir" && printf '%s' "$prompt" | jq -r '.' \
    | "$JEV" --timeout "$TIMEOUT" "$QUESTIONS" 2>/dev/null)" || { SKIPPED=$((SKIPPED + 1)); continue; }
  elapsed=$(( $(now_ms) - started ))

  read -r choice confidence <<<"$(printf '%s' "$answers" \
    | jq -r --arg id "$ANSWER_ID" '.[$id] | "\(.choice // "?") \(.confidence // 0)"' 2>/dev/null)"
  [[ "$choice" == "?" ]] && { SKIPPED=$((SKIPPED + 1)); continue; }

  correct=0
  [[ "$choice" == "$label" ]] && correct=1
  printf '%s %s\n' "$correct" "$confidence" >> "$RESULTS"
  printf '%s\n' "$elapsed" >> "$LATENCIES"
  printf '  %s  said=%s truth=%s conf=%s  %sms\n' \
    "$([[ $correct -eq 1 ]] && echo PASS || echo MISS)" "$choice" "$label" "$confidence" "$elapsed"
# Newest first across every project. The sort happens after the timestamps are
# collected, so it stays global however many transcripts there are — `ls -t`
# would be batched by xargs and sorted only within each batch.
done < <(find "$PROJECTS" -name '*.jsonl' -type f -print0 \
  | perl -0ne 'chomp; my @s = stat $_; print join("\t", $s[9] // 0, $_), "\n"' \
  | sort -rn | cut -f2-)

ANSWERED="$(wc -l < "$RESULTS" | tr -d ' ')"
echo
printf 'sessions with a prompt and a label: %s\n' "$TOTAL"
printf 'answered: %s   skipped (off-allowlist or failed): %s\n' "$ANSWERED" "$SKIPPED"
[[ "$ANSWERED" -gt 0 ]] || { echo "nothing to score"; exit 1; }

echo
echo "threshold  coverage  accuracy-above  accuracy-overall"
LC_ALL=C awk '{correct[NR] = $1; conf[NR] = $2; n = NR}
END {
  for (t = 50; t <= 95; t += 5) {
    thr = t / 100; above = 0; hit = 0; all = 0
    for (i = 1; i <= n; i++) {
      all += correct[i]
      if (conf[i] >= thr) { above++; hit += correct[i] }
    }
    printf "  %.2f      %5.1f%%    %s          %5.1f%%\n", thr, 100 * above / n,
      (above > 0 ? sprintf("%5.1f%%", 100 * hit / above) : "    -  "), 100 * all / n
  }
}' "$RESULTS"

echo
sort -n "$LATENCIES" | LC_ALL=C awk '{v[NR] = $1; n = NR}
END {
  p50 = v[int(0.50 * (n - 1)) + 1]
  p95 = v[int(0.95 * (n - 1)) + 1]
  printf "latency  p50=%sms  p95=%sms  max=%sms\n", p50, p95, v[n]
}'
